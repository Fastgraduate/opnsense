# FastAPI / encryption
# Generate with: python keygen.py
APP_ENCRYPTION_KEY=

# OPNsense and Elasticsearch defaults (individual firewall settings override these)
OPNSENSE_TIMEOUT=20
OPNSENSE_VERIFY_SSL=false
ELASTIC_URL=http://127.0.0.1:9200
ELASTIC_API_KEY=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_VERIFY_SSL=false

# V32 model paths (normally no change is needed)
# ML_V32_DIR=../ml/v32
# ML_V32_MODEL_PATH=../ml/v32/ttp_v32_final_7class_bundle.joblib

# Automatic response safety defaults
AUTO_BLOCK_ENABLED=false
AUTO_BLOCK_DRY_RUN=true
AUTO_BLOCK_RISK_THRESHOLD=90
AUTO_BLOCK_CONFIDENCE_THRESHOLD=85
AUTO_BLOCK_MIN_OCCURRENCES=3
AUTO_BLOCK_DURATION_MINUTES=60
AUTO_BLOCK_INTERFACE=wan
AUTO_BLOCK_ALLOWED_CLASSES=Cross_Site_Scripting,SQL_Injection,System_Cmd_Execution
AUTO_BLOCK_ALLOWLIST=
AUTO_BLOCK_ALLOW_PRIVATE=false
AUTO_BLOCK_REQUIRE_SURICATA_CONFIRMATION=true
SECURITY_BLOCK_ALIAS=blocked_attackers

# V32-FINAL ML -> Elasticsearch enrichment pipeline
# Model files are bundled under backend/ml/v32 by default.
ML_PIPELINE_ENABLED=false
ML_PIPELINE_INTERVAL_SECONDS=5
ML_PIPELINE_BATCH_SIZE=100
ML_PIPELINE_LOOKBACK_MINUTES=180
ML_PIPELINE_MARK_SKIPPED=true
# Optional override if model files are stored elsewhere:
# ML_V32_DIR=C:\\path\\to\\backend\\ml\\v32
