# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Local / sensitive backend files
backend/.env
backend/firewalls.json
backend/data/firewalls.json.enc

# Raw dataset zip
202506_web_data_set.Zip

# =========================
# ML data - root ml folder case
# 기준: repo root에 .gitignore가 있고, ML 코드가 ml/ 폴더 안에 있는 경우
# =========================

ml/data/raw/*
ml/data/interim/*
ml/data/processed/*

# external은 기본적으로 무시하되, 필요한 보강 데이터셋 하나만 추적
ml/data/external/*
!ml/data/external/
!ml/data/external/.gitkeep
!ml/data/external/http_params_train_only_for_augmentation.csv

# Keep ML data directory structure
!ml/data/raw/.gitkeep
!ml/data/interim/.gitkeep
!ml/data/processed/.gitkeep

# ML artifacts
ml/artifacts/models/*
ml/artifacts/vectorizers/*
ml/artifacts/vocab/*

!ml/artifacts/models/.gitkeep
!ml/artifacts/vectorizers/.gitkeep
!ml/artifacts/vocab/.gitkeep

# ML outputs
ml/outputs/reports/*
ml/outputs/confusion/*
ml/outputs/error_analysis/*
ml/outputs/analysis/*

!ml/outputs/reports/.gitkeep
!ml/outputs/confusion/.gitkeep
!ml/outputs/error_analysis/.gitkeep
!ml/outputs/analysis/.gitkeep

# =========================
# ML data - current ml directory case
# 기준: .gitignore가 ml/ 폴더 안에 있는 경우
# =========================

data/raw/*
data/interim/*
data/processed/*

# external은 기본적으로 무시하되, 필요한 보강 데이터셋 하나만 추적
data/external/*
!data/external/.gitkeep
!data/external/http_params_train_only_for_augmentation.csv

# Keep data directory structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Artifacts
artifacts/models/*
artifacts/vectorizers/*
artifacts/vocab/*

!artifacts/models/.gitkeep
!artifacts/vectorizers/.gitkeep
!artifacts/vocab/.gitkeep

# Outputs
outputs/reports/*
outputs/confusion/*
outputs/error_analysis/*
outputs/analysis/*

!outputs/reports/.gitkeep
!outputs/confusion/.gitkeep
!outputs/error_analysis/.gitkeep
!outputs/analysis/.gitkeep